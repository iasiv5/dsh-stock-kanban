{
  "name": "dsh-stock-kanban",
  "version": "0.1.0",
  "description": "DSH 轻量多市场盯盘与持仓查看插件：悬浮胶囊 + A股/港股/美股/加密货币分组自选 + 持仓盈亏 + 目标价 + 分时/日周月K。数据存 DSH 实例（跨浏览器共享）。",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.mjs",
    "lib/client.js",
    "icon.svg",
    "locale/*.json",
    "data/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "probe": "node scripts/probe-markets.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
