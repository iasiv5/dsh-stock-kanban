#!/bin/sh
# 推送门（2026-11-10 retro #3）：全套离线测试。本仓 npm test 即规格书
# （钉 CSS 契约串/DOM 契约/i18n 对齐），红灯不得落进远端历史。
# 启用（clone 后一次性）：git config core.hooksPath .githooks
# 预检（2026-11-10 retro #4）：前置条件失败给一行诊断，不让几十行
# ERR_MODULE_NOT_FOUND 淹没信号。
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ ! -d node_modules ]; then
  echo "pre-push: node_modules 缺失（dsh plugin add/remove 已知副作用）→ 先 npm ci 再推" >&2
  exit 1
fi
chrome_count=$(pgrep -c chrome 2>/dev/null || true)
chrome_count=${chrome_count:-0}
if [ "$chrome_count" != "0" ]; then
  echo "pre-push: 检测到 $chrome_count 个 chrome 进程（headless 曾把 npm test 22s→700s）→ 先收尾再推" >&2
  exit 1
fi
npm test --silent
